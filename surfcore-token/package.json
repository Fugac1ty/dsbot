{
  "name": "surfcore-token",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每日 token 额度与用量采集、峰谷计价、80%/100% 闸门",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node scripts/test-smoke.mjs",
    "test:vendor": "echo \"先按 PLAN.md 跑 tools/vendor.mjs，再把 roots 填进 package.json 的这个脚本\""
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
